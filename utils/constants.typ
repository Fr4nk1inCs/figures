/// Length of one cetz canvas unit. 28.35pt ≈ 1cm.
#let CANVAS-LENGTH = 28.35pt

/// Default padding for cetz canvas margins and content placement.
#let PADDING = 0.2

/// Default opacity reduction for tinted fills (60% transparent = 40% opaque).
#let TRANSPARENCY = 60%

/// Default lighten factor for tinted fills (90% lighten = 10% of original color).
#let LIGHTEN = 90%
